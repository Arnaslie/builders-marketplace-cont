# Copy to .env and fill in. Never commit .env. Only this example file is committed.
# BUILD vs RUN: every variable below is RUN-time only (read by the server).
# None may be exposed to the browser (no VITE_ / NEXT_PUBLIC_ / REACT_APP_ prefix).

# --- LLM for the cart-building agent (Anthropic Claude)
LLM_API_KEY=

# --- Channel3 product search -- https://trychannel3.com/developers (OPTIONAL)
# A trial key. Without it the app degrades gracefully to the committed price cache
# in contract/prices.json, so this can be left blank. Do not depend on it long-term.
CHANNEL3_API_KEY=

# --- AG Grid Enterprise licence (OPTIONAL). Leave blank to run Community /
# Enterprise-with-watermark. The licence key is shipped to the browser by design
# in AG Grid, so treat it as a non-secret trial key and see SETUP.md step 8.
AG_GRID_LICENSE_KEY=

# --- AG Charts Enterprise / AG Studio licence (OPTIONAL). Blank = AG Charts Community.
# Read on the server and shipped to the browser by design, like AG_GRID_LICENSE_KEY.
AG_CHARTS_LICENSE_KEY=

# --- App
PORT=3000

# --- Checkout (coming soon)
# PayPal checkout was stubbed out pending a Stripe integration. When Stripe lands,
# add STRIPE_SECRET_KEY and STRIPE_PUBLISHABLE_KEY here.