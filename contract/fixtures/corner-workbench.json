{
  "id": "proj-corner-workbench",
  "slug": "corner-workbench",
  "status": "published",
  "title": "Corner Workbench",
  "summary": "A right-angle workbench that fits an unused corner, with a full-width lower shelf and a jack vise.",
  "difficulty": "intermediate",
  "estimatedHours": 8,
  "imageUrl": null,
  "currency": "USD",
  "steps": [
    "Cut the frame legs and rails, then lay out the corner profile so the two top halves meet at a right angle.",
    "Screw the legs to the long and short aprons, squaring each leg to its apron before tightening.",
    "Screw the two 2 ft x 2 ft top slabs together along the mitered edge, then screw them to the frame.",
    "Install the jack vise flush at the front edge of the short leg, with the jaws squared to the top.",
    "Fit the lower shelf on cleats screwed to the legs, 18 in off the floor.",
    "Glue and screw corner gussets under the top for stiffness, then sand and wipe on two coats of oil."
  ],
