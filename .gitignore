.env
.env.*
!.env.example
node_modules/
.next/
next-env.d.ts
# api (Python / uv)
.venv/
__pycache__/
.pytest_cache/
# verify skill: disposable app copies and proof artifacts
.verify/
# build artifacts and local agent tooling (kept on disk, not tracked)
tsconfig.tsbuildinfo
*.tsbuildinfo
# .claude/ holds local agent settings, which stay untracked. The verification skill under it is
# part of the review evidence for every PR that touches a page or route, so it IS tracked: a
# feature file that only exists on one machine cannot be shown to have been followed.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/verify-diy-wikipedia/
# video submission: recorded takes and rendered frame sequences are large and local-only.
# Keep the scripts, reel definitions and final cut; drop the raw media by default.
video-submission/takes/
video-submission/video/out/
video-submission/video/.clipcache/
video-submission/video/audio/
!video-submission/video/audio/.gitkeep
